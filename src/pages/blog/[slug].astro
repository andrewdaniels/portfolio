---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Shell title={post.data.title} description={post.data.excerpt} image={post.data.cover || undefined}>
  <article class="wrap post">
    <a class="link-arrow back" href="/blog"><Icon name="left" size={14} /> Writing</a>
    <header>
      <p class="eyebrow">{fmt(post.data.date)}{post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}</p>
      <h1 class="display h-lg">{post.data.title}</h1>
      <div class="by"><img src={site.avatar} alt="" width="32" height="32" /> {site.name}</div>
    </header>
    {post.data.cover && <img class="cover" src={post.data.cover} alt="" />}
    <div class="prose"><Content /></div>
  </article>
  <Footer />
</Shell>
<style>
  .post { max-width: 780px; margin: 0 auto; padding-top: clamp(28px, 5vw, 64px); padding-bottom: 80px; }
  .back { font-size: 14px; color: var(--soft); margin-bottom: 40px; }
  header { display: grid; gap: 14px; margin-bottom: 36px; }
  .by { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 15px; }
  .by img { border-radius: 50%; }
  .cover { border-radius: var(--radius-lg); margin-bottom: 36px; }
</style>
