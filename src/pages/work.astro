---
import Shell from '../layouts/Shell.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const now = projects.filter((p) => p.data.status === 'now');
const past = projects.filter((p) => p.data.status !== 'now');
const filters = [
  { label: 'All', key: '' },
  { label: 'AI', key: 'ai' },
  { label: 'Design systems', key: 'design system' },
  { label: 'FlutterFlow', key: 'flutterflow' },
  { label: 'SaaS', key: 'saas' },
  { label: 'White-label', key: 'white-label' },
  { label: 'Healthcare', key: 'health' },
];
---
<Shell title="Work" description="Products I'm building now, and 13 years of past work for startups and brands like FlutterFlow, the WHO, Chili's and Torchy's.">
  <header class="wrap page-head">
    <p class="eyebrow">Work</p>
    <h1 class="display h-xl">Products I'm building, and the ones I helped build.</h1>
  </header>

  <section class="wrap">
    <p class="eyebrow sub">Building now</p>
    <div class="grid two">{now.map((p) => <ProjectCard project={p} size="lg" />)}</div>
  </section>

  <section class="wrap">
    <div class="filter-row">
      <p class="eyebrow sub">Past work · {past.length}</p>
      <div class="filters" role="group" aria-label="Filter projects">
        {filters.map((f, i) => <button class="fchip" data-f={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
    </div>
    <div class="grid three" id="past-grid">{past.map((p) => <ProjectCard project={p} />)}</div>
  </section>

  <Footer />
</Shell>

<style>
  .page-head { padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(24px, 3vw, 40px); }
  .page-head h1 { max-width: 16ch; margin-top: 14px; }
  .sub { margin-bottom: 16px; }
  .grid { display: grid; gap: 8px; }
  .two { grid-template-columns: repeat(2, 1fr); }
  .three { grid-template-columns: repeat(3, 1fr); }
  .filter-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin: 24px 0 16px; }
  .filter-row .sub { margin: 0; }
  .filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .fchip { height: 34px; padding: 0 14px; border-radius: 999px; font-size: 14px; font-weight: 500; color: var(--soft); box-shadow: inset 0 0 0 1px var(--line); transition: all .2s; }
  .fchip:hover { color: var(--text); }
  .fchip[aria-pressed='true'] { background: var(--text); color: var(--bg); box-shadow: none; }
  :global(.pcard.hide) { display: none; }
  @media (max-width: 1100px) { .three { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .two, .three { grid-template-columns: 1fr; } }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.fchip');
  const cards = document.querySelectorAll<HTMLElement>('#past-grid .pcard');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      const k = c.dataset.f || '';
      cards.forEach((card) => card.classList.toggle('hide', !!k && !(card.dataset.cats || '').includes(k)));
    })
  );
</script>
