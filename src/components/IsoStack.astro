---
/**
 * Isometric stack of screens that slowly cycles through a project's images.
 * Layers spread apart when a parent with class "iso-host" is hovered.
 */
interface Props { images: string[]; layers?: number; class?: string; tall?: boolean }
const { images, layers = 3, class: cls = '', tall = false } = Astro.props;
const pool = images.filter(Boolean);
const n = Math.min(layers, pool.length);
const stack = Array.from({ length: n }, (_, i) => pool[i % pool.length]);
---
{n > 0 && (
  <div class:list={['iso', cls, { tall }]} data-iso={JSON.stringify(pool)} aria-hidden="true">
    <div class="iso-plane">
      {stack.map((src, i) => (
        <div class="iso-layer" style={`--i:${i}`}>
          <img src={src} alt="" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .iso {
    position: relative;
    width: 100%; height: 100%;
    display: grid; place-items: center;
    pointer-events: none;
  }
  .iso-plane {
    position: relative;
    width: 64%;
    aspect-ratio: 16 / 10.5;
    transform-style: preserve-3d;
    transform: rotateX(54deg) rotateZ(-38deg) translateZ(-30px);
    transition: transform 1s var(--ease);
  }
  .iso.tall .iso-plane { width: 40%; aspect-ratio: 9 / 18; }
  .iso-layer {
    position: absolute; inset: 0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .06), -30px 40px 60px -10px rgba(0, 0, 0, .35);
    transform: translateZ(calc(var(--i) * 34px));
    transition: transform .9s var(--ease), opacity .6s, filter .6s;
    animation: iso-float 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.2s);
  }
  .iso-layer img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .iso-layer:not(:last-child) { filter: brightness(.86); }
  @keyframes iso-float {
    0%, 100% { translate: 0 0 0; }
    50% { translate: 0 0 10px; }
  }
  :global(.iso-host:hover) .iso-plane { transform: rotateX(50deg) rotateZ(-34deg) translateZ(-10px); }
  :global(.iso-host:hover) .iso-layer { transform: translateZ(calc(var(--i) * 72px)); filter: none; }
  /* cycling: the top layer lifts away, then the stack re-deals */
  .iso.shift .iso-layer:last-child { transform: translateZ(calc(var(--i) * 34px + 120px)); opacity: 0; }
  .iso.shift .iso-layer:not(:last-child) { transform: translateZ(calc((var(--i) + 1) * 34px)); }
  :global(.iso-host:hover) .iso.shift .iso-layer:last-child { transform: translateZ(calc(var(--i) * 72px + 140px)); }
  .iso.no-anim .iso-layer { transition: none; }
  :global(.iso-host:hover) .iso.shift .iso-layer:not(:last-child) { transform: translateZ(calc((var(--i) + 1) * 72px)); }
</style>

<script>
  const stacks = document.querySelectorAll<HTMLElement>('.iso[data-iso]');
  const visible = new WeakSet<Element>();
  const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target))));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  stacks.forEach((el, k) => {
    const pool: string[] = JSON.parse(el.dataset.iso || '[]');
    const imgs = [...el.querySelectorAll('img')];
    if (pool.length <= 1 || reduce) return;
    io.observe(el);
    let head = imgs.length; // next image to deal onto the bottom
    let order = imgs.map((i) => i.getAttribute('src')!);
    setTimeout(() => setInterval(() => {
      if (!visible.has(el) || document.hidden) return;
      el.classList.add('shift');
      setTimeout(() => {
        // drop top, push a new card on the bottom
        order = [pool[head % pool.length], ...order.slice(0, -1)];
        head++;
        el.classList.add('no-anim');
        imgs.forEach((im, i) => im.setAttribute('src', order[i]));
        el.classList.remove('shift');
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('no-anim')));
      }, 900);
    }, 3600), k * 700);
  });
</script>
