---
import site from '../data/site.json';
import work from '../data/work.json';
import Icon from './Icon.astro';
---
<dialog class="sheet" id="about" aria-labelledby="about-title">
  <div class="sheet-inner">
    <div class="sheet-top">
      <span class="eyebrow">About</span>
      <button class="icon-btn" data-close aria-label="Close"><Icon name="close" size={18} /></button>
    </div>
    <div tabindex="-1" autofocus class="sheet-body about">
      <div class="about-id">
        <img src={site.avatar} alt="" width="64" height="64" />
        <div>
          <strong>{site.name}</strong>
          <span class="faint">{site.role} · {site.location}</span>
        </div>
      </div>
      <h2 id="about-title" class="h-md">{site.intro.headline}</h2>
      <p class="lede">{site.intro.body}</p>
      <p class="lede">{site.past.body}</p>

      <blockquote class="about-quote">“{site.quote}”</blockquote>

      <div class="about-stats">
        {site.stats.map((s) => (<div><b>{s.value}</b><span>{s.label}</span></div>))}
      </div>

      <h3 class="about-h">Experience</h3>
      <ol class="xp">
        {work.map((w) => (
          <li>
            <div class="xp-top"><strong>{w.company}</strong><span class="faint">{w.years}</span></div>
            <div class="muted xp-role">{w.role}</div>
            <p>{w.description}</p>
          </li>
        ))}
      </ol>

      <h3 class="about-h">Recognition</h3>
      <ul class="awards">
        {site.awards.map((a) => (<li><strong>{a.title}</strong><span class="faint">{a.org} · {a.year} · {a.note}</span></li>))}
      </ul>

      <h3 class="about-h">Clients</h3>
      <div class="clients-cloud">{site.clients.map((c) => <span class="chip">{c}</span>)}</div>

      <div class="about-cta">
        <button class="btn" data-open="contact">Start a conversation <Icon name="arrow" size={16} /></button>
        <a class="btn ghost" href="/work">See the work</a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .about > * + * { margin-top: 18px; }
  .about-id { display: flex; align-items: center; gap: 14px; }
  .about-id img { border-radius: 50%; }
  .about-id div { display: grid; line-height: 1.3; }
  .about-id span { font-size: 14px; }
  .about-quote {
    font-size: 20px; font-weight: 500; letter-spacing: -.01em; line-height: 1.4;
    padding: 18px 20px; border-radius: var(--radius-lg); background: var(--surface);
    border-left: 3px solid var(--accent);
  }
  .about-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .about-stats div { padding: 16px; border-radius: var(--radius-md); background: var(--surface); display: grid; }
  .about-stats b { font-size: 30px; letter-spacing: -.03em; line-height: 1.1; }
  .about-stats span { font-size: 13px; color: var(--soft); }
  .about-h { font-size: 13px; font-family: var(--font-mono); font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); padding-top: 18px; }
  .xp { list-style: none; padding: 0; display: grid; gap: 0; }
  .xp li { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .xp-top { display: flex; justify-content: space-between; gap: 12px; }
  .xp-top span { font-family: var(--font-mono); font-size: 13px; }
  .xp-role { font-size: 15px; margin-bottom: 6px; }
  .xp p { font-size: 15px; color: var(--soft); }
  .awards { list-style: none; padding: 0; display: grid; gap: 10px; }
  .awards li { display: grid; }
  .awards span { font-size: 14px; }
  .clients-cloud { display: flex; flex-wrap: wrap; gap: 6px; }
  .about-cta { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 12px; }
</style>
