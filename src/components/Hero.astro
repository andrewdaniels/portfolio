---
import site from '../data/site.json';
import Icon from './Icon.astro';
import KnowHimHero from './KnowHimHero.astro';
import UncomnHero from './UncomnHero.astro';
---
<div class="hero-wrap" data-active="0">
<div class="story-bars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <i><b></b></i>)}</div>
<section class="hero" data-hot="" aria-label="Introduction">

  <!-- 1. Intro -->
  <article class="tile t-intro iso-host" data-i="0">
    <div class="tile-copy">
      {site.photo && <div class="intro-top"><img class="intro-photo" src={site.photo} alt={site.name} width="56" height="56" /></div>}
      <p class="eyebrow">{site.intro.eyebrow}</p>
      <h1 class="display">{site.intro.headline}</h1>
      <div class="more">
        <p class="muted">{site.intro.body}</p>
        <div class="actions">
          <button class="btn sm" data-open="about">More about me</button>
        </div>
      </div>
    </div>
    <div class="intro-glyph" aria-hidden="true">
      <span>Design</span><span>Build</span><span>Ship</span>
    </div>
  </article>

  <!-- 2. Uncomn -->
  <article class="tile t-uncomn on-photo iso-host" data-i="1">
    <a class="stretch" href="/projects/uncomn" aria-label="Uncomn case study"></a>
    <div class="tile-copy">
      <p class="eyebrow"><span class="now-dot"></span>Building now</p>
      <h2 class="tile-h">Uncomn</h2>
      <p class="tile-sub">Your next meeting, right on your home screen. Discipleship for church groups.</p>
      <div class="more actions">
        <a class="btn sm" href="/projects/uncomn">Case study <Icon name="arrow" size={14} /></a>
        <a class="btn sm ghost" href="https://uncomn.co" target="_blank" rel="noopener">uncomn.co</a>
      </div>
    </div>
    <div class="tile-media"><UncomnHero /></div>
  </article>

  <!-- 3. KnowHim -->
  <article class="tile t-knowhim on-photo iso-host" data-i="2">
    <a class="stretch" href="/projects/knowhim" aria-label="KnowHim case study"></a>
    <div class="tile-copy">
      <p class="eyebrow"><span class="now-dot"></span>Building now</p>
      <h2 class="tile-h">KnowHim</h2>
      <p class="tile-sub">Grow, pray and know Him. Together. A prayer and small-group app.</p>
      <div class="more actions">
        <a class="btn sm" href="/projects/knowhim">Case study <Icon name="arrow" size={14} /></a>
        <a class="btn sm ghost" href="https://knowhim.app" target="_blank" rel="noopener">knowhim.app</a>
      </div>
    </div>
    <div class="tile-media"><KnowHimHero variant="tile" /></div>
  </article>

  <!-- 4. Past -->
  <article class="tile t-past" data-i="3">
    <a class="stretch" href="/work" aria-label="Past work"></a>
    <div class="tile-copy">
      <p class="eyebrow">Before this</p>
      <div class="past-stats">
        <div><b>13<small>yrs</small></b><span>Leading Kaleo Design</span></div>
        <div><b>2.3<small>M</small></b><span>FlutterFlow users, from zero</span></div>
        <div><b>$30<small>M+</small></b><span>Raised at FlutterFlow</span></div>
      </div>
    </div>
    <div class="marquee" aria-hidden="true">
      <div>{[...site.clients, ...site.clients].map((c) => <span>{c}</span>)}</div>
    </div>
    <span class="corner-go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
  </article>

  <!-- 5. Contact -->
  <article class="tile t-contact" data-i="4">
    <div class="tile-copy">
      <span class="chip live">Open to fractional work</span>
    </div>
    <div class="tile-copy contact-bottom">
      <h2 class="contact-h">Have something in mind?</h2>
      <button class="btn sm" data-open="contact">Let's talk <Icon name="arrow" size={14} /></button>
      <p class="contact-note">{site.location} · Remote since {site.remoteSince}</p>
    </div>
  </article>

</section>
<div class="story-hint" aria-hidden="true">Tap to continue · Scroll for more</div>
</div>

<style>
  .hero-wrap { position: relative; }
  /* bento: intro tall on the left, Uncomn wide on top, KnowHim + contact below, stats strip under the intro */
  .hero {
    --cA: 1.08fr; --cB: 1fr; --cC: .6fr;
    --r1: 1.2fr; --r2: .58fr; --r3: .62fr;
    position: relative;
    height: calc(100dvh - 16px);
    min-height: 600px;
    padding: 8px;
    display: grid;
    gap: 8px;
    grid-template-columns: var(--cA) var(--cB) var(--cC);
    grid-template-rows: var(--r1) var(--r2) var(--r3);
    grid-template-areas:
      'intro uncomn  uncomn'
      'intro knowhim contact'
      'past  knowhim contact';
    transition: grid-template-columns .7s var(--ease), grid-template-rows .7s var(--ease);
  }
  .t-intro { grid-area: intro; }
  .t-uncomn { grid-area: uncomn; }
  .t-knowhim { grid-area: knowhim; }
  .t-past { grid-area: past; }
  .t-contact { grid-area: contact; }
  .hero[data-hot='0'] { --cA: 1.4fr; --r1: 1.35fr; }
  .hero[data-hot='1'] { --r1: 1.55fr; --cB: 1.15fr; }
  .hero[data-hot='2'] { --cB: 1.35fr; --r2: .8fr; --r3: .8fr; --r1: 1fr; }
  .hero[data-hot='3'] { --cA: 1.3fr; --r3: .85fr; }
  .hero[data-hot='4'] { --cC: .95fr; --r2: .72fr; --r3: .72fr; }

  .tile {
    --mx: 50%; --my: 50%;
    position: relative; overflow: hidden; isolation: isolate;
    border-radius: 28px;
    background: var(--surface);
    padding: clamp(20px, 2.2vw, 32px);
    display: flex; flex-direction: column; justify-content: space-between;
    transition: opacity .5s, filter .5s;
    min-width: 0; min-height: 0;
  }
  .tile::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(520px circle at var(--mx) var(--my), var(--accent-soft), transparent 60%);
    opacity: 0; transition: opacity .4s;
  }
  .tile:hover::before { opacity: 1; }
  .hero[data-hot]:not([data-hot='']) .tile:not(:hover) { opacity: .78; filter: saturate(.85); }
  .stretch { position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .tile-copy { position: relative; z-index: 2; max-width: 34rem; pointer-events: none; }
  .tile-copy a, .tile-copy button { pointer-events: auto; }
  .tile-copy > * + * { margin-top: 12px; }
  .more {
    display: grid; gap: 14px;
    opacity: 0; translate: 0 10px; max-height: 0;
    transition: opacity .4s, translate .6s var(--ease), max-height .6s var(--ease);
  }
  .tile:hover .more, .tile:focus-within .more { opacity: 1; translate: 0 0; max-height: 220px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .now-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); margin-right: 8px; vertical-align: 1px; animation: pulse-a 2s infinite; }
  @keyframes pulse-a { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  /* intro */
  .t-intro { background: var(--text); color: var(--bg); }
  .t-intro .eyebrow { color: color-mix(in oklab, var(--bg) 55%, transparent); }
  .t-intro .muted { color: color-mix(in oklab, var(--bg) 70%, transparent); }
  .t-intro .chip { background: color-mix(in oklab, var(--bg) 12%, transparent); color: var(--bg); }
  .t-intro .btn { background: var(--bg); color: var(--text); }
  .t-intro .btn.ghost { background: transparent; color: var(--bg); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--bg) 30%, transparent); }
  .intro-top { display: flex; align-items: center; gap: 12px; }
  .intro-photo { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 3px color-mix(in oklab, var(--bg) 20%, transparent); }
  .t-intro h1 { font-size: clamp(30px, 3.6vw, 56px); max-width: 15ch; }
  .t-intro .more { opacity: 1; translate: 0 0; max-height: 260px; margin-top: 20px; max-width: 36ch; }
  .intro-glyph {
    position: absolute; right: -2%; bottom: -6%; z-index: 0;
    display: grid; text-align: right;
    font-family: var(--font-display); font-weight: 900; letter-spacing: -.06em; line-height: .82;
    font-size: clamp(44px, 5vw, 92px);
    color: color-mix(in oklab, var(--bg) 9%, transparent);
    transition: color .6s, translate .9s var(--ease);
  }
  .intro-glyph span { transition: translate .9s var(--ease); }
  .t-intro:hover .intro-glyph { color: var(--accent); }
  .t-intro:hover .intro-glyph span:nth-child(1) { translate: -24px 0; }
  .t-intro:hover .intro-glyph span:nth-child(2) { translate: -12px 0; }
  .t-intro:hover .intro-glyph { translate: 0 -8px; }

  .tile-h { font-size: clamp(30px, 3.4vw, 52px); letter-spacing: -.04em; }
  .tile-sub { color: var(--soft); max-width: 24ch; }

  .tile-media { position: absolute; inset: 0; z-index: 0; pointer-events: none; border-radius: inherit; overflow: hidden; }
  .on-photo { color: #fff; }
  .on-photo .tile-copy { text-shadow: 0 1px 14px rgba(0,0,0,.35); }
  .on-photo .eyebrow { color: rgba(255,255,255,.8); }
  .on-photo .tile-sub { color: rgba(255,255,255,.88); }
  .on-photo .tile-media::after { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1;
    background: linear-gradient(160deg, rgba(10,14,18,.55) 0%, rgba(10,14,18,.12) 42%, rgba(10,14,18,0) 60%); }
  .on-photo .btn { background: #fff; color: #101416; }
  .on-photo .btn.ghost { background: rgba(255,255,255,.14); color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); backdrop-filter: blur(10px); }
  .on-photo::before { display: none; }

  .t-past { justify-content: space-between; padding-bottom: 18px; }
  .t-past .tile-copy > * + * { margin-top: 10px; }
  .t-past .past-stats { display: grid; grid-template-columns: repeat(3, auto); gap: clamp(14px, 2vw, 32px); justify-content: start; }
  .past-stats div { display: grid; }
  .past-stats b { font-family: var(--font-display); font-size: clamp(28px, 2.9vw, 46px); letter-spacing: -.045em; line-height: 1; transition: color .4s; }
  .past-stats b small { font-size: .45em; letter-spacing: -.02em; color: var(--soft); margin-left: 2px; }
  .past-stats span { font-size: 13px; color: var(--soft); max-width: 14ch; line-height: 1.3; margin-top: 4px; }
  .corner-go { position: absolute; top: 16px; right: 16px; z-index: 2; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--bg); transition: transform .4s var(--ease), background-color .3s, color .3s; }
  .t-past:hover .corner-go { background: var(--accent); color: #fff; transform: rotate(45deg); }

  /* contact: the accent tile */
  .t-contact { background: var(--accent); color: #fff; }
  .t-contact::before { background: radial-gradient(360px circle at var(--mx) var(--my), rgba(255,255,255,.22), transparent 60%); }
  .t-contact .chip { background: rgba(255,255,255,.18); color: #fff; }
  .t-contact .chip.live::before { background: #fff; box-shadow: none; }
  .contact-bottom { display: grid; gap: 12px; justify-items: start; }
  .contact-bottom > * + * { margin-top: 0; }
  .contact-h { font-size: clamp(22px, 2vw, 32px); letter-spacing: -.035em; line-height: 1.05; max-width: 9ch; }
  .t-contact .btn { background: #fff; color: #101416; }
  .contact-note { font-size: 12px; color: rgba(255,255,255,.75); font-family: var(--font-mono); letter-spacing: .02em; }
  .t-past:hover .past-stats b { color: var(--accent); }
  .marquee {
    position: relative; z-index: 0; overflow: hidden; margin: 0 calc(-1 * clamp(20px, 2.4vw, 36px));
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee div { display: flex; gap: 36px; width: max-content; animation: marquee 40s linear infinite; }
  .t-past:hover .marquee div { animation-duration: 16s; }
  .marquee span { font-family: var(--font-display); font-weight: 700; font-size: clamp(15px, 1.25vw, 19px); letter-spacing: -.02em; color: var(--faint); white-space: nowrap; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .story-bars, .story-hint { display: none; }

  @media (max-width: 1100px) and (min-width: 761px) {
    .hero { grid-template-areas: 'intro uncomn uncomn' 'intro knowhim knowhim' 'past contact contact'; --cC: .8fr; }
    .contact-note, .t-intro .more .muted { display: none; }
  }

  /* ---------- mobile: the quadrants become stories ---------- */
  @media (max-width: 760px) {
    .hero {
      height: calc(100dvh - 76px);
      min-height: 0;
      display: flex; gap: 0; padding: 8px;
      overflow-x: auto; overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .hero::-webkit-scrollbar { display: none; }
    .tile { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; padding: 56px 22px 28px; }
    .tile + .tile { margin-left: 8px; }
    .hero[data-hot] .tile:not(:hover) { opacity: 1; filter: none; }
    .more { opacity: 1; translate: 0 0; max-height: none; }
    .stretch { pointer-events: none; }
    .t-intro { justify-content: flex-start; }
    .intro-top { display: flex; align-items: center; gap: 12px; }
  .intro-photo { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 3px color-mix(in oklab, var(--bg) 20%, transparent); }
  .t-intro h1 { font-size: 40px; }
    .tile-h { font-size: 44px; }
    .t-uncomn :global(.un-port) { --un-right: 50%; --un-w: min(64cqw, 270px); --un-bottom: -22%; }
    .t-uncomn :global(.un-fit) { translate: 36% 0; }
    .t-knowhim :global(.kh-port) { --kh-left: 50%; --kh-top: 66%; --kh-scale: min(calc(100cqw / 700px), 0.62); }
    .t-past, .t-contact { justify-content: flex-start; gap: 32px; }
    .contact-h { font-size: 44px; }
    .contact-bottom { margin-top: auto; }
    .corner-go { display: none; }
    .t-past .past-stats { grid-template-columns: 1fr; gap: 22px; }
    .past-stats b { font-size: 56px; }
    .past-stats span { font-size: 14px; }
    .marquee span { font-size: 20px; }
    .story-bars {
      display: flex; gap: 4px; position: absolute; z-index: 5; top: 22px; left: 30px; right: 30px; pointer-events: none;
      color: var(--text); transition: color .3s;
    }
    .hero-wrap[data-active='0'] .story-bars, .hero-wrap[data-active='0'] .story-hint { color: var(--bg); }
    .hero-wrap[data-active='1'] .story-bars, .hero-wrap[data-active='2'] .story-bars, .hero-wrap[data-active='4'] .story-bars { color: #fff; }
    .hero-wrap:not([data-active='0']) .story-hint { opacity: 0; }
    .story-bars i { flex: 1; height: 3px; border-radius: 3px; background: color-mix(in oklab, currentColor 22%, transparent); overflow: hidden; }
    .story-bars b { display: block; height: 100%; width: 0; background: currentColor; border-radius: 3px; }
    .intro-glyph { display: none; }
    .story-hint {
      display: block; position: absolute; bottom: 18px; left: 0; right: 0; z-index: 5; pointer-events: none;
      text-align: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--soft); opacity: .7;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const tiles = [...hero.querySelectorAll<HTMLElement>('.tile')];
    const mobile = matchMedia('(max-width: 760px)');

    // desktop: hovered quadrant grows; spotlight follows the cursor
    tiles.forEach((t) => {
      t.addEventListener('pointerenter', () => { if (!mobile.matches) hero.dataset.hot = t.dataset.i!; });
      t.addEventListener('pointermove', (e) => {
        const r = t.getBoundingClientRect();
        t.style.setProperty('--mx', `${e.clientX - r.left}px`);
        t.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
    hero.addEventListener('pointerleave', () => { hero.dataset.hot = ''; });

    // mobile: stories
    const wrap = hero.parentElement!;
    const bars = [...wrap.querySelectorAll<HTMLElement>('.story-bars b')];
    const DURATION = 6000;
    let idx = 0, elapsed = 0, last = 0, paused = false, raf = 0;
    const current = () => Math.round(hero.scrollLeft / hero.clientWidth);
    const go = (i: number) => {
      idx = (i + tiles.length) % tiles.length;
      elapsed = 0;
      hero.scrollTo({ left: idx * (hero.scrollWidth / tiles.length), behavior: 'smooth' });
    };
    const tick = (now: number) => {
      if (!mobile.matches) { raf = 0; return; }
      const dt = last ? now - last : 0; last = now;
      if (!paused && !document.hidden) elapsed += dt;
      if (elapsed >= DURATION) go(idx + 1);
      wrap.dataset.active = String(idx);
      bars.forEach((b, i) => (b.style.width = i < idx ? '100%' : i === idx ? `${Math.min(100, (elapsed / DURATION) * 100)}%` : '0%'));
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (mobile.matches && !raf) { last = 0; raf = requestAnimationFrame(tick); } };
    mobile.addEventListener('change', start);
    start();

    let scrollT = 0;
    hero.addEventListener('scroll', () => {
      clearTimeout(scrollT);
      scrollT = window.setTimeout(() => { const c = current(); if (c !== idx) { idx = c; elapsed = 0; } }, 80);
    }, { passive: true });
    hero.addEventListener('pointerdown', () => { paused = true; });
    window.addEventListener('pointerup', () => { paused = false; });
    hero.addEventListener('click', (e) => {
      if (!mobile.matches) return;
      if ((e.target as HTMLElement).closest('a, button')) return;
      const x = e.clientX - hero.getBoundingClientRect().left;
      go(x < hero.clientWidth * 0.3 ? idx - 1 : idx + 1);
    });
    // stop the autoplay once the story is scrolled out of view
    new IntersectionObserver(([en]) => { paused = !en.isIntersecting; }, { threshold: 0.4 }).observe(hero);
  }
</script>
