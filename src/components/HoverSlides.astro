---
/**
 * One hero image per project. On hover the image zooms slightly and swipes
 * through the first three shots; on touch screens it advances slowly while visible.
 */
interface Props { images: string[]; alt?: string; count?: number }
const { images, alt = '', count = 3 } = Astro.props;
const shots = [...new Set(images.filter(Boolean))].slice(0, count);
---
{shots.length > 0 && (
  <div class="slides" data-slides={shots.length} style="--i:0">
    <div class="slides-track">
      {shots.map((src, k) => <img src={src} alt={k === 0 ? alt : ''} loading={k === 0 ? 'eager' : 'lazy'} decoding="async" />)}
    </div>
    {shots.length > 1 && <div class="slides-dots" aria-hidden="true">{shots.map(() => <i></i>)}</div>}
  </div>
)}

<style is:global>
  .slides { position: absolute; inset: 0; overflow: hidden; }
  .slides-track {
    display: flex; height: 100%;
    translate: calc(var(--i) * -100%) 0;
    transition: translate .75s cubic-bezier(.65, 0, .35, 1), scale .9s var(--ease);
  }
  .slides-track img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .iso-host:hover .slides-track { scale: 1.035; }
  .slides-dots {
    position: absolute; left: 50%; bottom: 12px; translate: -50% 0; display: flex; gap: 5px;
    padding: 5px 7px; border-radius: 999px; background: rgba(10, 14, 18, .45); backdrop-filter: blur(8px);
    opacity: 0; transition: opacity .3s;
  }
  .iso-host:hover .slides-dots, .slides.auto .slides-dots { opacity: 1; }
  .slides-dots i { width: 6px; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, .45); transition: width .3s, background-color .3s; }
  .slides[style*='--i:0'] .slides-dots i:nth-child(1),
  .slides[style*='--i:1'] .slides-dots i:nth-child(2),
  .slides[style*='--i:2'] .slides-dots i:nth-child(3) { width: 16px; background: #fff; }
  @media (prefers-reduced-motion: reduce) { .slides-track { transition: none; } }
</style>

<script>
  const touch = matchMedia('(hover: none)').matches;
  document.querySelectorAll<HTMLElement>('.slides[data-slides]').forEach((el) => {
    const n = Number(el.dataset.slides);
    if (n < 2) return;
    let i = 0, t = 0;
    const set = (k: number) => { i = k % n; el.setAttribute('style', `--i:${i}`); };
    const host = el.closest<HTMLElement>('.iso-host') || el.parentElement!;
    if (!touch) {
      host.addEventListener('pointerenter', () => {
        clearInterval(t);
        setTimeout(() => set(1), 250);
        t = window.setInterval(() => set(i + 1), 1300);
      });
      host.addEventListener('pointerleave', () => { clearInterval(t); set(0); });
    } else {
      el.classList.add('auto');
      new IntersectionObserver(([e]) => {
        clearInterval(t);
        if (e.isIntersecting) t = window.setInterval(() => set(i + 1), 2600);
      }, { threshold: 0.6 }).observe(el);
    }
  });
</script>
