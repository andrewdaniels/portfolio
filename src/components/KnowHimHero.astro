---
/**
 * KnowHim's live hero, ported from andrewdaniels/knowhim-web (index.html):
 * the meadow photo plus the glass "stage" that cycles Prayers → Course → Circle
 * every 4s. The stage is a fixed 640x350 design scaled to fit its box.
 */
import '../styles/knowhim-port.css';
interface Props { class?: string; bg?: boolean; variant?: 'full' | 'tile' }
const { class: cls = '', bg = true, variant = 'full' } = Astro.props;
---
<div class:list={['kh-root kh-port', cls, `v-${variant}`, { 'no-bg': !bg }]} data-kh-theme="dark" aria-hidden="true">
  {bg && <><div class="km-hero-bg"></div><div class="km-scrim"></div><div class="km-ground"></div></>}
  <div class="kh-fit">
<div class="km-stage-wrap">
<div class="km-stage" aria-hidden="true">
  <span class="km-word" style="animation-delay:0s">Grow in your faith.</span>
  <span class="km-word" style="animation-delay:4s">Pray with others.</span>
  <span class="km-word" style="animation-delay:8s">Learn together.</span>
  <div class="km-dots"><span class="km-dot" style="animation-delay:0s"></span><span class="km-dot" style="animation-delay:4s"></span><span class="km-dot" style="animation-delay:8s"></span></div>

  <!-- 1 · Prayers (streak) -->
  <div class="km-card km-prayers" style="animation-delay:0s">
    <div class="km-pr-glow"></div>
    <p class="km-pr-date">Thursday, October 15</p>
    <p class="km-pr-title">Prayers</p>
    <div class="km-pr-streak"><img src="/media/knowhim-v2/hero/streak-flame.webp" alt="" width="25" height="32"><span>46</span></div>
    <div class="km-pr-done"><img src="/media/knowhim-v2/hero/prayer-completed.svg" alt="" width="48" height="48"><img class="km-pr-done-check" src="/media/knowhim-v2/hero/prayer-status-check.svg" alt="" width="31" height="31"></div>
    <div class="km-pr-week-outline"></div>
    <div class="km-pr-week-fill"></div>
    <div class="km-pr-days">
      <div class="km-pr-day"><span>S</span><i style="animation-delay:.10s"><img src="/media/knowhim-v2/hero/completed-day.svg" alt="" width="38" height="38"><img class="km-ck" src="/media/knowhim-v2/hero/completion-check.svg" alt="" width="26" height="26"></i></div>
      <div class="km-pr-day"><span>M</span><i style="animation-delay:.25s"><img src="/media/knowhim-v2/hero/completed-day.svg" alt="" width="38" height="38"><img class="km-ck" src="/media/knowhim-v2/hero/completion-check.svg" alt="" width="26" height="26"></i></div>
      <div class="km-pr-day"><span>T</span><i style="animation-delay:.40s"><img src="/media/knowhim-v2/hero/completed-day.svg" alt="" width="38" height="38"><img class="km-ck" src="/media/knowhim-v2/hero/completion-check.svg" alt="" width="26" height="26"></i></div>
      <div class="km-pr-day"><span>W</span><i style="animation-delay:.55s"><img src="/media/knowhim-v2/hero/completed-day.svg" alt="" width="38" height="38"><img class="km-ck" src="/media/knowhim-v2/hero/completion-check.svg" alt="" width="26" height="26"></i></div>
      <div class="km-pr-day km-today"><span>T</span><i style="animation-delay:.70s"><img src="/media/knowhim-v2/hero/completed-day.svg" alt="" width="38" height="38"><img class="km-ck" src="/media/knowhim-v2/hero/completion-check.svg" alt="" width="26" height="26"></i></div>
      <div class="km-pr-day"><span>F</span><b>16</b></div>
      <div class="km-pr-day"><span>S</span><b>17</b></div>
    </div>
    <p class="km-pr-goal">Weekly goal</p>
    <p class="km-pr-goal-n">5 of 7 days</p>
    <div class="km-pr-bar"><div class="km-fill" style="width:359px;animation-delay:.2s"></div></div>
  </div>

  <!-- 2 · Prayer circle, this week -->
  <div class="km-card km-circle" style="animation-delay:4s">
    <div class="km-ci-tabs">
      <span class="km-ci-tab km-on">This week</span><span class="km-ci-tab">Chat</span><span class="km-ci-sp"></span>
      <span class="km-ci-streak"><img src="/media/knowhim-v2/hero/streak-art.webp" alt="" width="20" height="20">2-week streak</span>
    </div>
    <div class="km-ci-sum">
      <p>11 of 12 prayers this week</p>
      <div class="km-ci-bar"><div class="km-fill" style="width:430px;animation-delay:4.2s"></div></div>
    </div>
    <div class="km-ci-member">
      <img class="km-ci-av" src="/media/knowhim-v2/hero/av-circle-you.webp" alt="" width="58" height="58">
      <div><p class="km-ci-name">You</p>
        <div class="km-ci-days"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><span class="km-ci-miss">W</span><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"></div>
        <p class="km-ci-meta">6 prayers · goal met</p></div>
    </div>
    <div class="km-ci-rule"></div>
    <div class="km-ci-member">
      <img class="km-ci-av" src="/media/knowhim-v2/hero/av-mario.webp" alt="" width="58" height="58">
      <div><p class="km-ci-name">Mario Daniels</p>
        <div class="km-ci-days"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><span class="km-ci-miss">M</span><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"><span class="km-ci-miss">F</span><img src="/media/knowhim-v2/hero/day-check.svg" alt="" width="30" height="30"></div>
        <p class="km-ci-meta">5 prayers · goal met</p></div>
    </div>
  </div>

  <!-- 3 · Journey with friends -->
  <div class="km-card km-journey" style="animation-delay:8s">
    <div class="km-jo-head">
      <div><p class="km-jo-kicker">Course · with friends</p><p class="km-jo-title">Broken and Poured Out</p><p class="km-jo-sub">15 Lessons • with 2 friends</p></div>
      <span class="km-jo-pill">Day 3 of 7</span>
    </div>
    <div class="km-jo-rows">
      <div class="km-jo-row"><img src="/media/knowhim-v2/hero/av-j-jordan.webp" alt="" width="33" height="33"><div><p><span>Jordan (you)</span><span>5 of 7</span></p><div class="km-jo-track"><div class="km-fill" style="width:71%;animation-delay:8.2s"></div></div></div></div>
      <div class="km-jo-row"><img src="/media/knowhim-v2/hero/av-j-ana.webp" alt="" width="33" height="33"><div><p><span>Ana</span><span>4 of 7</span></p><div class="km-jo-track"><div class="km-fill" style="width:57%;animation-delay:8.35s"></div></div></div></div>
      <div class="km-jo-row"><img src="/media/knowhim-v2/hero/av-j-you.webp" alt="" width="33" height="33"><div><p><span>You</span><span>3 of 7</span></p><div class="km-jo-track"><div class="km-fill" style="width:43%;animation-delay:8.5s"></div></div></div></div>
    </div>
    <p class="km-jo-note"><img src="/media/knowhim-v2/hero/stars-02.svg" alt="" width="23" height="23">Ana finished The Cross Shaped Life 35 mins ago</p>
  </div>
</div>
</div>


  </div>
</div>

<style is:global>
  .kh-port { position: absolute; inset: 0; overflow: hidden; font-family: Figtree, system-ui, sans-serif; --kh-page: var(--surface); container-type: size; }
  .kh-port .km-scrim { height: 70%; }
  .kh-port .km-ground { height: 34%; }
  .kh-port .kh-fit { position: absolute; left: 50%; top: var(--kh-top, 52%); width: 640px; height: 440px; translate: -50% -50%;
    scale: min(calc(100cqw / 690px), calc(100cqh / 540px), 1.3); }
  .kh-port .km-stage-wrap { margin: 0; }
  .kh-port .km-card, .kh-port .km-word, .kh-port .km-dot, .kh-port .km-fill { animation-play-state: var(--kh-play, running); }
  /* tile: no rotating headline, stage tucked low-right under the tile copy */
  .kh-port.v-tile .km-word, .kh-port.v-tile .km-dots { display: none; }
  .kh-port.v-tile .kh-fit { left: var(--kh-left, 62%); top: var(--kh-top, 74%); height: 380px; translate: -50% -34%;
    scale: var(--kh-scale, min(calc(100cqw / 980px), calc(100cqh / 700px), 1)); transform-origin: 50% 34%; }
  .kh-port.v-tile .km-card { top: 20px; }
  .kh-port.no-bg .km-word { color: var(--text); text-shadow: none; }
</style>
