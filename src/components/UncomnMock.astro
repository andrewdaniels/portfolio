---
/** Coded, animated phone mockup of Uncomn's home-screen widgets (sample data). */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class:list={['uphone', cls]} aria-hidden="true">
  <div class="uphone-screen">
    <div class="u-status"><span>9:41</span><span class="u-dots"><i></i><i></i><i></i></span></div>
    <div class="u-notif">
      <div class="u-app"></div>
      <div><b>Uncomn</b><span>Men's Group starts in 1 hour. Tap to RSVP.</span></div>
    </div>
    <div class="u-widget u-large">
      <div class="u-label">Next meeting</div>
      <div class="u-title">Men's Group</div>
      <div class="u-meta">Thu · 7:00 PM · Romans 8</div>
      <ul class="u-check">
        <li style="--d:0"><i></i>RSVP</li>
        <li style="--d:1"><i></i>Read Romans 8</li>
        <li style="--d:2"><i></i>Weekly reflection</li>
      </ul>
    </div>
    <div class="u-row">
      <div class="u-widget u-small">
        <div class="u-label">Lesson</div>
        <div class="u-big">4<small>/12</small></div>
        <div class="u-bar"><span></span></div>
      </div>
      <div class="u-widget u-small u-att">
        <div class="u-label">Attendance</div>
        <div class="u-big">92<small>%</small></div>
        <div class="u-spark"><i style="--h:.5"></i><i style="--h:.7"></i><i style="--h:.6"></i><i style="--h:.9"></i><i style="--h:.85"></i><i style="--h:1"></i></div>
      </div>
    </div>
    <div class="u-apps">{Array.from({ length: 8 }).map((_, i) => <i style={`--k:${i}`}></i>)}</div>
  </div>
</div>

<style>
  .uphone {
    --u-bg: #0d1013;
    --u-card: #1a2026;
    --u-ink: #f4f4f2;
    --u-soft: rgba(244, 244, 242, .55);
    width: 230px; aspect-ratio: 9 / 19.2;
    border-radius: 38px; padding: 9px;
    background: #050607;
    box-shadow: 0 0 0 1.5px #2a3138, 0 40px 80px -24px rgba(0, 0, 0, .55);
    transition: transform .9s var(--ease);
    font-family: var(--font-sans);
  }
  .uphone-screen {
    position: relative; height: 100%; border-radius: 30px; overflow: hidden;
    padding: 34px 12px 12px;
    background: radial-gradient(120% 70% at 20% 0%, color-mix(in oklab, var(--accent) 45%, #0d1013) 0%, #0d1013 60%);
    color: var(--u-ink);
    display: flex; flex-direction: column; gap: 8px;
  }
  .u-status { position: absolute; top: 10px; left: 22px; right: 18px; display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; }
  .u-dots { display: flex; gap: 3px; align-items: center; }
  .u-dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--u-ink); }
  .u-widget { background: rgba(26, 32, 38, .82); backdrop-filter: blur(10px); border-radius: 18px; padding: 12px; }
  .u-label { font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .u-title { font-size: 17px; font-weight: 700; letter-spacing: -.02em; margin-top: 2px; }
  .u-meta { font-size: 10px; color: var(--u-soft); }
  .u-check { list-style: none; padding: 0; margin-top: 10px; display: grid; gap: 6px; }
  .u-check li { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 500; }
  .u-check i {
    width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--u-soft); position: relative;
    animation: u-tick 6s infinite; animation-delay: calc(var(--d) * .7s + .6s);
  }
  @keyframes u-tick {
    0%, 8% { background: transparent; box-shadow: inset 0 0 0 1.5px var(--u-soft); }
    14%, 80% { background: var(--accent); box-shadow: inset 0 0 0 1.5px var(--accent); }
    92%, 100% { background: transparent; box-shadow: inset 0 0 0 1.5px var(--u-soft); }
  }
  .u-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .u-small { padding: 10px; }
  .u-big { font-size: 26px; font-weight: 700; letter-spacing: -.04em; line-height: 1.1; margin-top: 2px; }
  .u-big small { font-size: 12px; color: var(--u-soft); letter-spacing: 0; }
  .u-bar { height: 4px; border-radius: 4px; background: rgba(255, 255, 255, .12); margin-top: 8px; overflow: hidden; }
  .u-bar span { display: block; height: 100%; width: 33%; background: var(--accent); border-radius: 4px; animation: u-fill 6s var(--ease) infinite; }
  @keyframes u-fill { 0%, 10% { width: 25%; } 30%, 85% { width: 33%; } 100% { width: 25%; } }
  .u-spark { display: flex; align-items: end; gap: 3px; height: 18px; margin-top: 6px; }
  .u-spark i { flex: 1; height: calc(var(--h) * 100%); border-radius: 2px; background: rgba(244, 244, 242, .25); }
  .u-spark i:last-child { background: #2fbf71; }
  .u-apps { margin-top: auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 4px; }
  .u-apps i { aspect-ratio: 1; border-radius: 11px; background: hsl(calc(var(--k) * 37 + 190) 12% calc(22% + var(--k) * 2%)); }
  .u-notif {
    position: absolute; left: 8px; right: 8px; top: 8px; z-index: 2;
    display: flex; gap: 8px; align-items: center;
    padding: 9px 10px; border-radius: 16px;
    background: rgba(40, 46, 52, .92); backdrop-filter: blur(12px);
    font-size: 10px; line-height: 1.3;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, .6);
    animation: u-notif 6s var(--ease) infinite;
  }
  .u-notif b { display: block; font-size: 10px; }
  .u-notif span { color: var(--u-soft); }
  .u-app { flex: none; width: 24px; height: 24px; border-radius: 7px; background: var(--accent); }
  @keyframes u-notif {
    0%, 52% { transform: translateY(-140%); opacity: 0; }
    60%, 88% { transform: translateY(0); opacity: 1; }
    96%, 100% { transform: translateY(-140%); opacity: 0; }
  }
  :global(.iso-host:hover) .uphone { transform: translateY(-14px) rotate(-3deg); }
</style>
